{
  "name": "@fulcrumapp/fulcrum-schema",
  "version": "3.9.1",
  "description": "Table schemas for Fulcrum apps",
  "main": "./dist/fulcrum-schema.js",
  "types": "./dist/fulcrum-schema.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/fulcrum-schema.d.ts",
      "require": "./dist/fulcrum-schema.js",
      "default": "./dist/fulcrum-schema.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "git://github.com/fulcrumapp/fulcrum-schema.git"
  },
  "scripts": {
    "test": "mocha -r ts-node/register ./test/setup.js test/test-postgres.js test/test-sqlite.js test/test-v2-to-v3.js test/test-v3-to-v4.js test/test-v4-to-v5.js test/test-v5-to-v6.js test/test-validation.js --reporter-option maxDiffSize=20000",
    "lint": "eslint src/*.js src/**/*.js",
    "build": "tsc && cp src/fulcrum-schema.d.ts dist/fulcrum-schema.d.ts && browserify dist/fulcrum-schema.js --mangle -o dist/fulcrum-schema.min.js",
    "prepack": "yarn clean && yarn build",
    "prepublishOnly": "yarn build",
    "clean": "rm -rf dist"
  },
  "author": "Fulcrum",
  "license": "BSD",
  "eslintConfig": {
    "extends": "fulcrum"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "sqldiff": "^0.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.42.1",
    "@typescript-eslint/parser": "^5.42.1",
    "browserify": "^17.0.0",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "fs-sync": "^1.0.6",
    "mocha": "^11.1.0",
    "season": "^6.0.2",
    "should": "^13.2.3",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4"
  }
}
